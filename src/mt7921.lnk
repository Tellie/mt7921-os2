# SPDX-License-Identifier: GPL-2.0-only
# wlink directives for MT7921.OS2 (the container of the QCA6174 and RTL88EU drivers: 16-bit NE "dll" with an
# IOPL code segment, no default libraries). hdr.obj must be first, end.obj last.
format os2 dll
name MT7921.OS2
option quiet,map=MT7921.map,verbose,caseexact,eliminate,nodefaultlibs
option description '@#TeLLie:0.45#@##1## 26 Nov 2026 09:30:00     ARCAOS-DEV::en:US:2:::@@MediaTek MT7921 PCIe WiFi driver for OS/2 and ArcaOS (GenMAC + NDIS, mt76 back end)'
segment class 'CODE' iopl
import DOSOPEN DOSCALLS.70
import DOSCLOSE DOSCALLS.59
import DOSREAD DOSCALLS.137
import DOSDEVIOCTL DOSCALLS.53
file obj/hdr.obj
file obj/lib.obj
file obj/ndisx.obj
file obj/strat.obj
file obj/pci.obj
file obj/mem.obj
file obj/mt_dma.obj
file obj/mt_fw.obj
file obj/mt_mac.obj
file obj/sta.obj
file obj/ndis.obj
file obj/genmac.obj
file obj/dbg.obj
file obj/end.obj
